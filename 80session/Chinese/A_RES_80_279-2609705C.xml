      <p>
        <inline name="agenda item name">联合国科索沃临时行政当局特派团经费的筹措</inline>
      </p>
      <p>
        <docTitle>2026年6月30日大会决议</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#fifthCommittee">[根据第五委员会的报告 (<inline name="originating document">A/80/568/Add.2，第15段</inline>)]</docProponent>
